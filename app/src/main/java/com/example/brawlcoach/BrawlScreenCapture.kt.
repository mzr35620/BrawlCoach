
package com.example.brawlcoach

import android.app.Activity
import android.content.Intent
import android.media.projection.MediaProjectionConfig
import android.media.projection.MediaProjectionManager
import android.os.Build

object BrawlScreenCapture {

    fun createCaptureIntent(activity: Activity): Intent? {

        // Refuser la capture ciblée sur les anciennes versions Android.
        if (Build.VERSION.SDK_INT < 34) {
            return null
        }

        val manager = activity.getSystemService(
            Activity.MEDIA_PROJECTION_SERVICE
        ) as MediaProjectionManager

        // Android laisse l'utilisateur choisir une seule application.
        return manager.createScreenCaptureIntent(
            MediaProjectionConfig.createConfigForUserChoice()
        )
    }
}
